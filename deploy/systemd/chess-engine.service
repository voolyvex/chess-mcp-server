[Unit]
Description=Chess MCP engine (Stockfish 18 behind an HTTP-to-UCI bridge)
Documentation=https://github.com/voolyvex/chess-mcp-server
# The Docker daemon is a system service; a user unit cannot order itself
# against it directly, so ExecStartPre waits for the socket instead.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/projects/chess-mcp-server

# Docker may still be coming up when the user session starts. Wait for the
# socket rather than failing and burning a restart.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do docker info >/dev/null 2>&1 && exit 0; sleep 2; done; echo "docker daemon did not become available" >&2; exit 1'

ExecStart=/usr/bin/docker compose up -d --wait engine
ExecStop=/usr/bin/docker compose stop engine

TimeoutStartSec=300

[Install]
WantedBy=default.target
